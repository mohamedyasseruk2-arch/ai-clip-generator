# Copy this file to .env and fill in your own values. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model (can also be changed in the app's Advanced settings)
# GEMINI_MODEL=gemini-3.5-flash

# ---- Autopilot posting (README, "Autopilot setup"). Only fill in the platforms you use. ----
# YouTube Shorts: Google Cloud OAuth client of type "Desktop app"
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# TikTok: developer app with Login Kit (desktop) + Content Posting API, redirect http://127.0.0.1:8765/callback/
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Instagram + Facebook: one Meta developer app (Business type)
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ID=            # only if you manage several Pages
# META_API_VERSION=v23.0
